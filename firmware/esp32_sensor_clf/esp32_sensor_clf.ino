#define DHT_PIN 15
// Set to the sensor you wired: DHT22 (default) or DHT11
#define DHT_TYPE DHT22
// 1 = print raw T,RH for dataset collection; 0 = run classifier
#define LOG_RAW 1

#if !LOG_RAW
#include "model.h" // generated by tools/bake_model.py (gitignored). Build fails without it.
#endif
#include <DHT.h>

DHT dht(DHT_PIN, DHT_TYPE);
static unsigned long errors = 0;

void setup() {
  Serial.begin(115200);
  dht.begin();
  pinMode(2, OUTPUT);
  Serial.println("# esp32_sensor_clf ready");
  Serial.print("# heap=");
  Serial.println(ESP.getFreeHeap());
}

void loop() {
  float t = dht.readTemperature();
  float h = dht.readHumidity();
  if (isnan(t) || isnan(h)) {
    errors++;
    Serial.print("# ERR dht_read_fail count=");
    Serial.println(errors);
    delay(2000);
    return;
  }
#if LOG_RAW
  Serial.print(t, 2); Serial.print(",");
  Serial.println(h, 2);
#else
  float f[2] = {t, h};
  unsigned long t0 = micros();
  int32_t cls = comfort_predict(f, 2);
  unsigned long dt = micros() - t0;
  Serial.print(t, 2); Serial.print(",");
  Serial.print(h, 2); Serial.print(",");
  Serial.print(cls); Serial.print(",");
  Serial.print(dt); Serial.print(",");
  Serial.println(ESP.getFreeHeap());
  digitalWrite(2, cls == 0 ? LOW : HIGH);
#endif
  delay(2000);
}
